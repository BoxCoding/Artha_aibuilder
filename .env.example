# Copy to .env for local development. Never commit a real .env.
# `python -m app.cli generate-secrets` prints fresh values for SECRET_KEY and RECEIPT_SIGNING_SEED.

# dev | test | prod. prod refuses to start unless everything marked (prod) below is set safely.
APP_ENV=dev

# Demo accounts (Meena, Arun, Divya, Risk Console) and sample statements. Refused in prod.
DEMO_MODE=true

# (prod) at least 32 random characters
SECRET_KEY=replace-me-with-a-long-random-value
# (prod) 32 bytes, base64. Without it receipts are signed by a key that disappears on restart.
RECEIPT_SIGNING_SEED=

# (prod) PostgreSQL. Leave empty for the in-memory store; sqlite:///var/artha.db for a local file.
# DATABASE_URL=postgresql+psycopg://artha:password@localhost:5432/artha
DATABASE_URL=

# inline - pipeline runs inside the API process (development)
# queue  - (prod) durable jobs in the database, processed by `python -m app.worker`
PIPELINE_MODE=inline
PIPELINE_CONCURRENCY=2

# offline  - no model calls at all; deterministic readers, memo and template explanations (default)
# ollama   - a local model served by Ollama (e.g. Gemma); no customer data leaves your infrastructure
# vertex   - Gemini on Vertex AI, using the Cloud Run service account
# api_key  - Gemini API, for local development only
LLM_MODE=offline
OLLAMA_URL=http://localhost:11434
# gemma3:4b or larger is recommended for memo writing; gemma3:1b drafts usually fail the quality gate
# and the deterministic memo is used instead. A vision model (e.g. gemma3:4b) lets scans be read.
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=
OLLAMA_NUM_PREDICT=1536
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GEMINI_API_KEY=

# Managed prompt-injection and sensitive-data screening. Leave blank to rely on the local layer.
# MODEL_ARMOR_TEMPLATE=projects/<project>/locations/asia-south1/templates/ledgerlens-guard
MODEL_ARMOR_LOCATION=asia-south1

# Accounts
ALLOW_SELF_REGISTRATION=true
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Other origins allowed to make state-changing requests (comma separated). Our own origin always is.
WEB_ORIGIN=
# true only behind a proxy that sets X-Forwarded-For (Cloud Run, a load balancer)
TRUST_PROXY_HEADERS=false

MAX_UPLOAD_MB=10
MAX_PAGES_PER_DOCUMENT=30
TOKEN_BUDGET_PER_CASE=400000
CASE_RETENTION_DAYS=30

# ---- Events, analytics and Google Cloud AI services (all optional; local equivalents run when empty)
EVENT_SINKS=log                 # log,pubsub
PUBSUB_TOPIC=                   # projects/<p>/topics/ledgerlens-events
ANALYTICS_BACKEND=local         # local | bigquery (reads the Pub/Sub → BigQuery events table)
BIGQUERY_PROJECT=
BIGQUERY_DATASET=ledgerlens
DOCUMENT_AI_PROCESSOR=          # projects/<p>/locations/us/processors/<id>  (scanned statements)
VERTEX_SEARCH_SERVING_CONFIG=   # .../engines/<app>/servingConfigs/default_search  (policy retrieval)
VERTEX_RISK_ENDPOINT=           # projects/<p>/locations/<region>/endpoints/<id>  (challenger model)

# ---- Compliance
LENDER_NAME=LedgerLens Finance Pvt Ltd (NBFC)
GRIEVANCE_OFFICER=Grievance Redressal Officer, grievance@lender.example, 1800-000-0000
PROCESSING_FEE_PCT=1.0
GST_ON_FEES_PCT=18.0
COOLING_OFF_DAYS=3
CASH_REPORTING_THRESHOLD=1000000
