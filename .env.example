# Copy to .env for local development. Never commit a real .env.
APP_ENV=dev
DEMO_MODE=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value

# offline  - no model calls at all; deterministic composer and template explanations (default)
# api_key  - Gemini API, for local development
# vertex   - Gemini on Gemini Enterprise Agent Platform, using the Cloud Run service account
LLM_MODE=offline
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GEMINI_API_KEY=

# Managed prompt-injection and sensitive-data screening. Leave blank to rely on the local layer.
# MODEL_ARMOR_TEMPLATE=projects/<project>/locations/asia-south1/templates/artha-guard
MODEL_ARMOR_LOCATION=asia-south1

MAX_UPLOAD_MB=10
MAX_PAGES_PER_DOCUMENT=30
TOKEN_BUDGET_PER_CASE=400000
